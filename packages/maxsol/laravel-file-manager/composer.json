{
  "name": "maxsol/laravel-file-manager",
  "description": "My custom Laravel package",
  "type": "library",
  "autoload": {
    "psr-4": {
      "Maxsol\\LaravelFileManager\\": "src/"
    }
  },
  "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "league/flysystem": "^3.0"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Maxsol\\LaravelFileManager\\LaravelFileManagerServiceProvider"
      ]
    }
  }
}